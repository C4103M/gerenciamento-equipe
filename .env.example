# Para rodar localmente com PostgreSQL:
DATABASE_URL="postgresql://postgres:1234@localhost:5432/nunca_foi_sort?schema=public"

# Na Vercel com Neon (Storage -> Neon), copie a DATABASE_URL fornecida automaticamente
# DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# URL pública da aplicação (usada nos links de ativação enviados por e-mail)
APP_URL="http://localhost:3000"

# Chave secreta para assinatura dos cookies de sessão (use uma string aleatória longa em produção)
AUTH_SECRET="troque-por-uma-chave-secreta-aleatoria-em-producao"

# Conta inicial do Administrador Global criada pelo prisma/seed.ts
ADMIN_NAME="Admin Global"
ADMIN_EMAIL="seu-email@dominio.com"
ADMIN_PASSWORD="sua-senha-segura"

# Envio de e-mail (configure Resend OU SMTP; sem eles o sistema usa preview local no painel admin/terminal)
# Opção 1 — Resend:
# RESEND_API_KEY=""
# EMAIL_FROM="Nunca Foi ICPC <noreply@seudominio.com>"

# Opção 2 — SMTP (ex: Gmail com Senha de App, Brevo, Mailtrap):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="seu-email@gmail.com"
# SMTP_PASS="sua-senha-de-app"
# EMAIL_FROM="Nunca Foi ICPC <seu-email@gmail.com>"
