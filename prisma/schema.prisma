generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GLOBAL_ADMIN
  MEMBER
}

enum Platform {
  CODEFORCES
  LEETCODE
  ATCODER
  BEECROWD
  CSES
  OUTRO
}

enum Difficulty {
  FACIL
  MEDIO
  DIFICIL
  MUITO_DIFICIL
}

enum ProposalStatus {
  PENDENTE
  VISUALIZADO
  TENTOU
  FEITO
  DESCARTADO
}

enum NotificationType {
  PROBLEM_PROPOSED
  PROPOSAL_STATUS_UPDATED
}

model Team {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  inviteCode       String            @unique
  description      String?
  maxMembers       Int               @default(3)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  members          User[]
  problemLogs      ProblemLog[]
  proposedProblems ProposedProblem[]
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  passwordHash       String?
  emailVerifiedAt    DateTime?
  role               UserRole            @default(MEMBER)
  teamId             String?
  team               Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  cfHandle           String?
  lcHandle           String?
  avatarColor        String              @default("#6366f1")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  problemLogs        ProblemLog[]
  proposedByMe       ProposedProblem[]   @relation("Proposer")
  proposedToMe       ProposedProblem[]   @relation("Assignee")
  notifications      Notification[]
  verificationTokens VerificationToken[]

  @@index([teamId])
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model Topic {
  id               String            @id @default(cuid())
  name             String            @unique
  slug             String            @unique
  color            String            @default("#3b82f6")
  isDefault        Boolean           @default(false)
  createdAt        DateTime          @default(now())

  problemLogs      ProblemLog[]      @relation("ProblemLogTopics")
  proposedProblems ProposedProblem[] @relation("ProposedProblemTopics")
}

model ProblemLog {
  id                  String            @id @default(cuid())
  teamId              String
  team                Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  url                 String
  platform            Platform          @default(OUTRO)
  perceivedDifficulty Difficulty        @default(MEDIO)
  solved              Boolean           @default(true)
  notes               String?           @db.Text
  needsReview         Boolean           @default(false)
  reviewedAt          DateTime?
  attemptCount        Int               @default(1)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  topics              Topic[]           @relation("ProblemLogTopics")
  fromProposals       ProposedProblem[] @relation("ProposalResultLog")

  @@index([teamId])
  @@index([userId])
  @@index([needsReview])
}

model ProposedProblem {
  id                  String         @id @default(cuid())
  teamId              String
  team                Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  proposerId          String
  proposer            User           @relation("Proposer", fields: [proposerId], references: [id], onDelete: Cascade)
  assigneeId          String
  assignee            User           @relation("Assignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  title               String
  url                 String
  platform            Platform       @default(OUTRO)
  suggestedDifficulty Difficulty?
  message             String?        @db.Text
  status              ProposalStatus @default(PENDENTE)
  resultingLogId      String?
  resultingLog        ProblemLog?    @relation("ProposalResultLog", fields: [resultingLogId], references: [id], onDelete: SetNull)
  viewedAt            DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  topics              Topic[]        @relation("ProposedProblemTopics")
  notifications       Notification[]

  @@index([teamId])
  @@index([assigneeId, status])
  @@index([proposerId])
}

model Notification {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              NotificationType
  title             String
  body              String
  link              String           @default("/propostos")
  read              Boolean          @default(false)
  emailSent         Boolean          @default(false) // Future email notification hook
  proposedProblemId String?
  proposedProblem   ProposedProblem? @relation(fields: [proposedProblemId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())

  @@index([userId, read])
}
